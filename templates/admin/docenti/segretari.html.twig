{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set rows = [] %}
  {% for c in dati.lista %}
    {% set rows = rows|merge([{
      cells: [
        {content: '<small>' ~ c.segretario.cognome ~ '</small>'},
        {content: '<small>' ~ c.segretario.nome ~ '</small>'},
        {content: '<small>' ~ c.segretario.username ~ '</small>', class: 'd-none d-md-table-cell'},
        {content: '<small>' ~ c.sede.nomeBreve ~ '</small>', class: 'd-none d-lg-table-cell'},
        {content: '<small>' ~ c ~ '</small>', class: 'd-none d-xl-table-cell'},
        {content: [
          '<a class="btn btn-primary btn-xs mr-1 mb-1" href="' ~ path('docenti_segretari_edit', {id: c.id}) ~ '" role="button" title="Modifica i dati del segretario"><i class="fas fa-edit"></i></a>',
          '<button type="button" class="btn btn-danger btn-xs mr-1 mb-1 gs-modal-confirm-button" title="Elimina il segretario" data-toggle="modal" data-target="#gs-modal-confirm" data-titolo="' ~ c.segretario.cognome ~ ' ' ~ c.segretario.nome ~ '" data-contenuto="' ~ ('message.cancella_segretario'|trans) ~ '" data-href="' ~ path('docenti_segretari_delete', {id: c.id}) ~ '" data-csrf="' ~ csrf_token('delete') ~ '"><i class="fas fa-trash"></i></button>'
        ], class: 'pb-0'}
      ]
    }]) %}
  {% endfor %}
  {% include 'admin/include/table-responsive.html.twig' with {
    headers: [
      {label: 'label.cognome'|trans},
      {label: 'label.nome'|trans},
      {label: 'label.username'|trans, hidden_class: 'd-none d-md-table-cell'},
      {label: 'label.sede'|trans, hidden_class: 'd-none d-lg-table-cell'},
      {label: 'label.classe'|trans, hidden_class: 'd-none d-xl-table-cell'},
      {label: 'label.action'|trans}
    ],
    rows: rows,
    empty_message: 'Nessun segretario trovato'
  } %}
  <div class="text-center mt-3">
    <a class="btn btn-primary btn-sm" href="{{ path('docenti_segretari_edit', {id: 0}) }}" role="button" title="Aggiungi un nuovo segretario">{{ 'label.add'|trans }}</a>
  </div>
  {{ include('admin/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_segretari'}) }}
  {{ include('admin/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('docenti_segretari') }}/"+p;
    return false;
  });
  $('#gs-modal-confirm').on('show.bs.modal', function(e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}
