{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive">
  {% if dati.lista is not empty %}
    <table class="table table-bordered table-hover table-striped table-sm gs-sticky-header" style="margin-top:-2.5rem">
      <thead class="thead-light">
        <tr class="sticky-top">
          <th class="col-auto" scope="col">{{ 'label.rappresentante'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.tipo'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for u in dati.lista %}
        <tr>
          <td><small>{{ u }}</small></td>
          <td><small>{% for r in u.rappresentante %}{{ ('label.rappresentante_' ~ r)|trans }}{{ not loop.last ? ', ' }}{% endfor %}</small></td>
          <td class="pb-0">
            <a class="btn btn-primary btn-xs mr-1 mb-1" href="{{ path('docenti_rappresentanti_edit', {id: u.id}) }}" role="button" title="Modifica i dati del rappresentante"><i class="fas fa-edit"></i></a>
            <button type="button" class="btn btn-danger btn-xs mr-1 mb-1 gs-modal-confirm-button" title="Elimina il rappresentante" data-toggle="modal" data-target="#gs-modal-confirm" data-titolo="{{ u }}" data-contenuto="{{ 'message.cancella_rappresentante_docenti'|trans }}" data-href="{{ path('docenti_rappresentanti_delete', {id: u.id}) }}" data-csrf="{{ csrf_token('delete') }}"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
  {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3">
            <a class="btn btn-primary btn-sm" href="{{ path('docenti_rappresentanti_edit', {id: 0}) }}" role="button" title="Aggiungi un nuovo rappresentante">{{ 'label.add'|trans }}</a>
          </td>
        </tr>
      </tfoot>
    </table>
  {% else %}
    <div class="alert alert-info" role="alert">
      Nessun rappresentante trovato
    </div>
  {% endif %}
  </div>
  <div class="text-center mt-3">
    <a class="btn btn-primary btn-sm" href="{{ path('docenti_rappresentanti_edit', {id: 0}) }}" role="button" title="Aggiungi un nuovo rappresentante">{{ 'label.add'|trans }}</a>
  </div>
  {{ include('admin/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_rappresentanti'}) }}
  {{ include('admin/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('docenti_rappresentanti') }}/"+p;
    return false;
  });
  $('#gs-modal-confirm').on('show.bs.modal', function(e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}
